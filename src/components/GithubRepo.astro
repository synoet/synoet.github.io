---
interface Props {
  repo: string; // format: "owner/repo"
  branch?: string;
}

const { repo, branch } = Astro.props;
const url = `https://github.com/${repo}`;
---

<a href={url} class="github-repo" target="_blank" rel="noopener noreferrer">
  <span class="prefix">gh:</span>{repo}{branch && <span class="branch">@{branch}</span>}
</a>

<style>
  .github-repo {
    display: inline;
    font-size: 0.75rem;
    font-family: 'Disket Mono', monospace;
  }

  .prefix {
    color: var(--fg-dim);
  }

  .branch {
    color: var(--fg-dim);
  }
</style>
